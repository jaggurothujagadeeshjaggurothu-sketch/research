# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud -> App settings -> Secrets
# Never commit the real secrets.toml.

# URL of a PUBLIC Ollama endpoint (Streamlit Cloud cannot reach your localhost).
# Example with an ngrok / Cloudflare tunnel:
OLLAMA_URL = "https://your-tunnel-url.ngrok-free.app"
OLLAMA_MODEL = "llama3.2"

# "0" = do not write history.json (recommended on shared/cloud deployments)
RESEARCHMATE_PERSIST = "0"
